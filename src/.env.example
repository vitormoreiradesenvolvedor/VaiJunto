APP_NAME=VaiJunto
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vaijunto
DB_USERNAME=vaijunto
DB_PASSWORD=secret

CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480

QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

REVERB_APP_ID=vaijunto-app
REVERB_APP_KEY=vaijunto-key
REVERB_APP_SECRET=vaijunto-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GOOGLE_MAPS_API_KEY=
